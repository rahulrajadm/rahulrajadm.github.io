---
import '../styles/global.css';
import SiteNav from '../components/SiteNav.astro';

const timeline = [
  {
    role: 'Graduate Research Assistant',
    org: 'Office of Institutional Research, University of Houston',
    when: 'Aug 2026–Present',
  },
  {
    role: 'Machine Learning Engineer',
    org: 'EmGenisys',
    when: 'Aug 2025–May 2026',
  },
  {
    role: 'Undergraduate Research Assistant',
    org: 'Oden Institute, The University of Texas at Austin',
    when: 'Sep 2023–May 2026',
  },
];

// Real walk-forward backtest output — wnba-bet/analysis/backtest.py, 2024 season,
// trained on 2022–2023 only, no lookahead. Bucketed into 10 predicted-probability
// deciles; dot radius encodes games-per-bucket (see /projects detail page).
const calibrationPoints = [
  { cx: 66.5, cy: 137.3, r: 6.9 },
  { cx: 99.5, cy: 177.1, r: 7.6 },
  { cx: 132.5, cy: 148.3, r: 7.9 },
  { cx: 165.5, cy: 175.8, r: 7.9 },
  { cx: 198.5, cy: 166.7, r: 7.9 },
  { cx: 231.5, cy: 93.3, r: 7.9 },
  { cx: 264.5, cy: 114.3, r: 8.3 },
  { cx: 297.5, cy: 98.5, r: 8.3 },
  { cx: 330.5, cy: 91.7, r: 9.6 },
  { cx: 363.5, cy: 20, r: 6.0 },
];
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>Rahul Raja Durai Murugan — Applied AI &amp; Agentic Systems</title>
		<meta name="description" content="I build the pipeline, the model, and the agent that runs it. ML systems and agentic infrastructure, grounded in real backtests and institutional data work." />
		<link rel="canonical" href="https://rahulrajadm.github.io/" />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Rahul Raja Durai Murugan" />
		<meta property="og:title" content="Rahul Raja Durai Murugan — Applied AI &amp; Agentic Systems" />
		<meta property="og:description" content="I build the pipeline, the model, and the agent that runs it. ML systems and agentic infrastructure, grounded in real backtests and institutional data work." />
		<meta property="og:url" content="https://rahulrajadm.github.io/" />
		<meta property="og:image" content="https://rahulrajadm.github.io/og-image.png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="Rahul Raja Durai Murugan — Applied AI &amp; Agentic Systems" />
		<meta name="twitter:description" content="I build the pipeline, the model, and the agent that runs it. ML systems and agentic infrastructure, grounded in real backtests and institutional data work." />
		<meta name="twitter:image" content="https://rahulrajadm.github.io/og-image.png" />
	</head>
	<body>
		<a href="#main" class="skip-link">Skip to content</a>

		<div class="wrap">
			<SiteNav current="/" />
			<div class="page">
				<aside class="sidebar sans" aria-label="Profile">
					<div>
						<h1 class="sb-name">Rahul<br />Raja Durai Murugan</h1>
						<p class="sb-tagline">Claude Certified Architect |<br />Applied AI and Agentic Systems</p>
					</div>
					<div class="sb-field">
						<span class="k">Education</span>
						<span class="v">M.S. Engineering Data Science &amp; AI<br />University of Houston<br /><br />B.S. Biomedical Engineering,<br />Statistics and Data Science<br />The University of Texas at Austin</span>
					</div>
					<div class="sb-field">
						<span class="k">Based</span>
						<span class="v">Houston, TX</span>
					</div>
					<div class="sb-field">
						<span class="k">Contact</span>
						<span class="v">
							<a href="mailto:rahulrdm13@gmail.com">email</a> &middot;
							<a href="https://linkedin.com/in/rahulrajadm" target="_blank" rel="noopener noreferrer">linkedin</a> &middot;
							<a href="https://github.com/rahulrajadm" target="_blank" rel="noopener noreferrer">github</a>
						</span>
					</div>
					<div class="sb-field">
						<span class="k">Resume</span>
						<span class="v"><a href="/resume.pdf">/resume.pdf</a></span>
					</div>
				</aside>

				<main id="main" class="body-col">
					<p class="headline sans">I build the pipeline, the model, and<br /><span class="accent">the agent</span> that runs it.</p>

					<nav aria-label="Experience timeline">
						<ul class="timeline sans">
							{timeline.map((item) => (
								<li>
									<span class="role">
										{item.role}
										<span class="org">{item.org}</span>
									</span>
									<span class="when mono">{item.when}</span>
								</li>
							))}
						</ul>
						<p class="timeline-more sans">→ full timeline on <a href="/about">/about</a></p>
					</nav>
				</main>
			</div>

			<section class="highlights-section" aria-labelledby="highlights-heading">
				<h2 class="highlights-title sans" id="highlights-heading">Highlights</h2>
				<div class="highlights-grid">
					<a class="h-card" href="/projects/sports-forecasting-pricing-engine">
						<div class="h-visual">
							<svg width="100%" height="100%" viewBox="0 0 400 260" role="img" aria-label="Calibration chart: predicted probability vs. observed win rate, WNBA model, 2024 backtest.">
								<line x1="50" y1="240" x2="50" y2="20" stroke="#D9D3D6" stroke-width="1" />
								<line x1="50" y1="240" x2="380" y2="240" stroke="#D9D3D6" stroke-width="1" />
								<line x1="50" y1="240" x2="380" y2="20" stroke="var(--wine)" stroke-width="1.4" stroke-dasharray="4 4" />
								{calibrationPoints.map((p) => (
									<circle cx={p.cx} cy={p.cy} r={p.r} fill="var(--periwinkle)" />
								))}
							</svg>
						</div>
						<div class="h-body sans">
							<p class="h-title"><span class="accent">Predicted</span> vs. observed win rate</p>
							<p class="h-caption">WNBA game model, 2024 walk-forward backtest — real data, no lookahead.</p>
							<p class="h-stat mono">65.8% · 0.242 Brier · n=240</p>
							<span class="h-link">Full writeup →</span>
						</div>
					</a>

					<a class="h-card" href="/research">
						<div class="h-visual">
							<img
								src="/images/research/model-vs-data-calibration.png"
								alt="Model-predicted vs. measured tumor volume, seven PDX lines"
								width="1354"
								height="766"
								loading="lazy"
							/>
						</div>
						<div class="h-body sans">
							<p class="h-title">Model vs. data — <span class="accent">tumor response</span></p>
							<p class="h-caption">Oden Institute research, presented at UT Austin's Undergraduate Research Forum.</p>
							<p class="h-stat mono">7 PDX lines · manuscript in prep</p>
							<span class="h-link">Full writeup →</span>
						</div>
					</a>

					<a class="h-card" href="/projects/sports-forecasting-pricing-engine">
						<div class="h-visual placeholder sans">
							<span>Screenshot coming soon</span>
						</div>
						<div class="h-body sans">
							<p class="h-title">Live <span class="accent">forecasting tools</span></p>
							<p class="h-caption">Sports Forecasting Tools for WNBA, MLB, and NFL — deployed and running against live odds.</p>
							<p class="h-stat mono">3 sports · live</p>
							<span class="h-link">Full writeup →</span>
						</div>
					</a>
				</div>
			</section>
		</div>
	</body>
</html>

<style>
  .wrap { max-width: 980px; margin: 0 auto; padding: 16px 24px 96px; position: relative; }

  .page {
    border: 1px solid var(--mauve-mid);
    display: grid;
    grid-template-columns: 320px 1fr;
    min-height: 420px;
  }
  @media (max-width: 640px) { .page { grid-template-columns: 1fr; } }

  .sidebar {
    padding: 30px 24px;
    border-right: 1px solid var(--mauve-mid);
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  @media (max-width: 640px) { .sidebar { border-right: none; border-bottom: 1px solid var(--mauve-mid); } }

  .sb-name { font-size: 26px; font-weight: 700; margin: 0; line-height: 1.2; font-family: var(--font-display); }
  .sb-tagline { font-size: 12.5px; margin: 5px 0 0; opacity: 0.9; line-height: 1.4; }

  .sb-field { font-size: 11.5px; }
  .sb-field .k { text-transform: uppercase; letter-spacing: 0.07em; display: block; margin-bottom: 4px; opacity: 0.75; }
  .sb-field .v { line-height: 1.55; display: block; }
  .sb-field .v a { color: var(--white); text-decoration: none; border-bottom: 1px solid var(--mauve-mid); }
  .sb-field .v a:hover { border-bottom-color: var(--white); }

  .body-col { padding: 30px 26px; }
  .headline { font-size: clamp(21px, 2.7vw, 27px); font-weight: 700; line-height: 1.32; margin: 0 0 24px; max-width: 40ch; font-family: var(--font-display); }
  .headline .accent { color: var(--rose); }

  .timeline { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--mauve-mid); }
  .timeline li { display: grid; grid-template-columns: 1fr auto; gap: 12px; padding: 12px 0; border-bottom: 1px solid var(--mauve-mid); font-size: 13.5px; align-items: baseline; }
  .timeline .role { font-weight: 600; }
  .timeline .org { display: block; font-weight: 400; font-size: 12px; opacity: 0.8; margin-top: 1px; }
  .timeline .when { font-size: 12px; opacity: 0.8; white-space: nowrap; }
  .timeline-more { font-size: 12.5px; margin: 12px 0 0; opacity: 0.9; }
  .timeline-more a { color: var(--white); }

  .highlights-section { margin-top: 28px; }
  .highlights-title {
    font-size: 12.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin: 0 0 16px;
    opacity: 0.85;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .highlights-title::before { content: ""; width: 14px; height: 1px; background: var(--rose); display: inline-block; }

  .highlights-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  @media (max-width: 820px) { .highlights-grid { grid-template-columns: 1fr; } }

  .h-card {
    border: 1px solid var(--mauve-mid);
    background: var(--ink);
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: var(--white);
  }
  .h-card:hover { border-color: var(--rose); }
  .h-card:focus-visible { outline: 2px solid var(--rose); outline-offset: 3px; }

  .h-visual {
    background: var(--plot-panel);
    padding: 10px;
    height: 170px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .h-visual img, .h-visual svg { max-width: 100%; max-height: 100%; }
  .h-visual.placeholder {
    background: var(--deep-plum);
    border: 1px dashed var(--mauve-mid);
    margin: 10px;
    height: 150px;
    color: var(--rose);
    font-size: 12px;
    text-align: center;
    padding: 16px;
  }

  .h-body { padding: 16px 18px 18px; display: flex; flex-direction: column; gap: 8px; flex-grow: 1; }
  .h-title { font-size: 14.5px; font-weight: 700; margin: 0; font-family: var(--font-display); }
  .h-title .accent { color: var(--rose); }
  .h-caption { font-size: 12.5px; opacity: 0.85; margin: 0; line-height: 1.5; flex-grow: 1; }
  .h-stat { font-size: 11px; opacity: 0.7; margin: 0; }
  .h-link { font-size: 12px; color: var(--rose); border-bottom: 1px solid var(--mauve-mid); align-self: flex-start; margin-top: 4px; }
  .h-card:hover .h-link { border-bottom-color: var(--rose); }
</style>
