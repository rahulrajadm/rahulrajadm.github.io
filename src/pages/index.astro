---
import '../styles/global.css';

const timeline = [
  {
    role: 'Graduate Research Assistant',
    org: 'Office of Institutional Research, University of Houston',
    when: 'Aug 2026–Present',
  },
  {
    role: 'Machine Learning Engineer',
    org: 'EmGenisys',
    when: 'Aug 2025–May 2026',
  },
  {
    role: 'Undergraduate Research Assistant',
    org: 'Oden Institute, UT Austin',
    when: 'Sep 2023–May 2026',
  },
];

// Real walk-forward backtest output — wnba-bet/analysis/backtest.py, 2024 season,
// trained on 2022–2023 only, no lookahead. Bucketed into 10 predicted-probability
// deciles; dot radius encodes games-per-bucket (see /projects detail page).
const calibrationPoints = [
  { cx: 66.5, cy: 137.3, r: 6.9 },
  { cx: 99.5, cy: 177.1, r: 7.6 },
  { cx: 132.5, cy: 148.3, r: 7.9 },
  { cx: 165.5, cy: 175.8, r: 7.9 },
  { cx: 198.5, cy: 166.7, r: 7.9 },
  { cx: 231.5, cy: 93.3, r: 7.9 },
  { cx: 264.5, cy: 114.3, r: 8.3 },
  { cx: 297.5, cy: 98.5, r: 8.3 },
  { cx: 330.5, cy: 91.7, r: 9.6 },
  { cx: 363.5, cy: 20, r: 6.0 },
];
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>Rahul Raja Durai Murugan — Applied AI &amp; Agentic Systems</title>
		<meta name="description" content="I build the pipeline, the model, and the agent that runs it. ML systems and agentic infrastructure, grounded in real backtests and institutional data work." />
	</head>
	<body>
		<a href="#main" class="skip-link">Skip to content</a>

		<div class="wrap">
			<div class="page">
				<aside class="sidebar sans" aria-label="Profile">
					<div>
						<h1 class="sb-name">Rahul<br />Raja Durai Murugan</h1>
						<p class="sb-tagline">Claude Certified Architect |<br />Applied AI and Agentic Systems</p>
					</div>
					<div class="sb-field">
						<span class="k">Education</span>
						<span class="v">M.S. Engineering Data Science &amp; AI<br />University of Houston<br /><br />B.S. Biomedical Engineering,<br />Statistics and Data Science<br />The University of Texas at Austin</span>
					</div>
					<div class="sb-field">
						<span class="k">Based</span>
						<span class="v">Houston, TX</span>
					</div>
					<div class="sb-field">
						<span class="k">Contact</span>
						<span class="v">
							<a href="mailto:rahulrdm13@gmail.com">email</a> &middot;
							<a href="https://linkedin.com/in/rahulrajadm">linkedin</a> &middot;
							<a href="https://github.com/rahulrajadm">github</a>
						</span>
					</div>
					<div class="sb-field">
						<span class="k">Resume</span>
						<span class="v"><a href="/resume.pdf">/resume.pdf</a></span>
					</div>
				</aside>

				<main id="main" class="body-col">
					<p class="headline sans">I build the pipeline, the model, and<br /><span class="accent">the agent</span> that runs it.</p>

					<nav aria-label="Experience timeline">
						<ul class="timeline sans">
							{timeline.map((item) => (
								<li>
									<span class="role">
										{item.role}
										<span class="org">{item.org}</span>
									</span>
									<span class="when mono">{item.when}</span>
								</li>
							))}
						</ul>
						<p class="timeline-more sans">→ full timeline on <a href="/about">/about</a></p>
					</nav>
				</main>
			</div>

			<section class="chart-section" aria-labelledby="chart-heading">
				<div class="chart-card">
					<div class="chart-chrome sans">
						<div class="chart-head">
							<p class="chart-title" id="chart-heading"><span class="predicted-label">Predicted</span> vs. observed win rate</p>
							<p class="chart-meta mono">WNBA game model · 2024 season, n=240</p>
						</div>
						<p class="chart-caption">Walk-forward backtest — trained on 2022–2023 only, tested on 2024, no lookahead. Real output from <span class="mono">wnba-bet/analysis/backtest.py</span>, run against the live database.</p>
						<div class="chart-stats mono">
							<div class="stat"><p class="v">65.8%</p><p class="k sans">accuracy</p></div>
							<div class="stat"><p class="v">0.242</p><p class="k sans">Brier score</p></div>
							<div class="stat"><p class="v">240</p><p class="k sans">games</p></div>
						</div>
						<p class="chart-context"><b>What does this mean?</b> Sports markets are priced by professionals and move in real time, so consistently beating them is hard by design (a model that looked too good would be the actual red flag). A Brier score (the standard way to grade probability forecasts) of 0.242 clears the 0.25 you'd get from pure guessing, and serious forecasting in any genuinely uncertain domain — weather, elections, sports — typically lands in this same 0.20–0.24 band even when the model is strong. The clearer signal: 65.8% accuracy against the 58% you'd get by always picking the home team is a real, repeatable edge, not noise.</p>
					</div>

					<div class="plot-panel">
						<div class="legend sans">
							<span class="legend-item"><span class="legend-dot"></span>observed rate</span>
							<span class="legend-item"><span class="legend-line"></span>perfect calibration</span>
						</div>
						<svg width="100%" height="240" viewBox="0 0 400 260" role="img" aria-label="Calibration chart: predicted probability on the x-axis from 0 to 100 percent, observed win rate on the y-axis from 0 to 100 percent, with a dashed diagonal reference line for perfect calibration. High-confidence buckets track the diagonal closely; low-confidence buckets are noisier on smaller samples.">
							<line x1="50" y1="240" x2="50" y2="20" stroke="#D9D3D6" stroke-width="1" />
							<line x1="50" y1="240" x2="380" y2="240" stroke="#D9D3D6" stroke-width="1" />
							<line x1="50" y1="240" x2="380" y2="20" stroke="var(--wine)" stroke-width="1.4" stroke-dasharray="4 4" />

							<text x="50" y="252" font-size="9" fill="#6B6570" font-family="monospace">0%</text>
							<text x="365" y="252" font-size="9" fill="#6B6570" font-family="monospace">100%</text>
							<text x="150" y="14" font-size="9.5" fill="#6B6570" font-family="sans-serif">predicted probability →</text>

							{calibrationPoints.map((p) => (
								<circle cx={p.cx} cy={p.cy} r={p.r} fill="var(--periwinkle)" />
							))}
						</svg>
					</div>
				</div>
			</section>
		</div>
	</body>
</html>

<style>
  .wrap { max-width: 980px; margin: 0 auto; padding: 40px 24px 96px; position: relative; }

  .page {
    border: 1px solid var(--mauve-mid);
    display: grid;
    grid-template-columns: 320px 1fr;
    min-height: 420px;
  }
  @media (max-width: 640px) { .page { grid-template-columns: 1fr; } }

  .sidebar {
    padding: 30px 24px;
    border-right: 1px solid var(--mauve-mid);
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  @media (max-width: 640px) { .sidebar { border-right: none; border-bottom: 1px solid var(--mauve-mid); } }

  .sb-name { font-size: 26px; font-weight: 700; margin: 0; line-height: 1.2; font-family: var(--font-display); }
  .sb-tagline { font-size: 12.5px; margin: 5px 0 0; opacity: 0.9; line-height: 1.4; }

  .sb-field { font-size: 11.5px; }
  .sb-field .k { text-transform: uppercase; letter-spacing: 0.07em; display: block; margin-bottom: 4px; opacity: 0.75; }
  .sb-field .v { line-height: 1.55; display: block; }
  .sb-field .v a { color: var(--white); text-decoration: none; border-bottom: 1px solid var(--mauve-mid); }
  .sb-field .v a:hover { border-bottom-color: var(--white); }

  .body-col { padding: 30px 26px; }
  .headline { font-size: clamp(21px, 2.7vw, 27px); font-weight: 700; line-height: 1.32; margin: 0 0 24px; max-width: 40ch; font-family: var(--font-display); }
  .headline .accent { color: var(--rose); }

  .timeline { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--mauve-mid); }
  .timeline li { display: grid; grid-template-columns: 1fr auto; gap: 12px; padding: 12px 0; border-bottom: 1px solid var(--mauve-mid); font-size: 13.5px; align-items: baseline; }
  .timeline .role { font-weight: 600; }
  .timeline .org { display: block; font-weight: 400; font-size: 12px; opacity: 0.8; margin-top: 1px; }
  .timeline .when { font-size: 12px; opacity: 0.8; white-space: nowrap; }
  .timeline-more { font-size: 12.5px; margin: 12px 0 0; opacity: 0.9; }
  .timeline-more a { color: var(--white); }

  .chart-section { margin-top: 28px; }
  .chart-card { border: 1px solid var(--mauve-mid); background: var(--ink); }
  .chart-chrome { padding: 20px 22px 16px; }
  .chart-head { display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 8px; }
  .chart-title { font-size: 15px; font-weight: 700; margin: 0; font-family: var(--font-display); }
  .chart-title .predicted-label { color: var(--rose); }
  .chart-meta { font-size: 11.5px; opacity: 0.75; }
  .chart-caption { font-size: 12.5px; opacity: 0.85; margin: 14px 0 0; max-width: 64ch; }
  .chart-stats { display: flex; gap: 26px; flex-wrap: wrap; margin-top: 16px; }
  .stat .v { font-size: 19px; font-weight: 700; margin: 0; }
  .stat .k { font-size: 10.5px; text-transform: uppercase; letter-spacing: 0.06em; opacity: 0.75; margin: 0; }

  .chart-context {
    margin-top: 16px;
    padding-top: 14px;
    border-top: 1px solid var(--mauve-mid);
    font-size: 12.5px;
    line-height: 1.55;
    opacity: 0.88;
    max-width: 66ch;
  }
  .chart-context b { color: var(--rose); opacity: 1; font-weight: 700; }

  .plot-panel { background: var(--plot-panel); padding: 18px 20px 14px; border-top: 1px solid var(--mauve-mid); }
  .legend { display: flex; gap: 20px; margin-bottom: 12px; font-size: 12px; color: #2A2740; }
  .legend-item { display: flex; align-items: center; gap: 6px; }
  .legend-dot { width: 9px; height: 9px; border-radius: 50%; background: var(--periwinkle); display: inline-block; }
  .legend-line { width: 16px; height: 0; border-top: 1.5px dashed var(--wine); display: inline-block; }
</style>
